{
  "name": "agent-harness-console",
  "private": true,
  "version": "1.3.0",
  "description": "Sandboxed Electron and experimental Capacitor shell for Agent Harness",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "sync:ui": "node scripts/sync-ui.mjs",
    "predev": "npm run sync:ui",
    "dev": "vite",
    "prebuild": "npm run sync:ui",
    "build": "vite build",
    "preview": "vite preview",
    "pretest": "npm run sync:ui",
    "test": "vitest run",
    "desktop": "electron .",
    "host:stage": "node scripts/stage-host-runtime.mjs",
    "desktop:dist": "node scripts/require-signing.mjs && npm run host:stage && electron-builder --config electron-builder.yml",
    "desktop:dist:unsigned": "npm run host:stage && electron-builder --config electron-builder.yml",
    "desktop:settings-smoke": "electron test/fixtures/safe-storage-smoke.cjs && electron test/fixtures/settings-window-smoke.cjs",
    "desktop:smoke": "node scripts/smoke-packaged-desktop.mjs",
    "mobile:sync": "npm run build && cap sync"
  },
  "dependencies": {},
  "devDependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/cli": "8.4.2",
    "@capacitor/core": "8.4.2",
    "@capacitor/ios": "8.4.2",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  }
}
