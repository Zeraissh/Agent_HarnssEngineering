{
  "name": "agent-harness-console",
  "private": true,
  "version": "0.1.0",
  "description": "Sandboxed Electron and experimental Capacitor shell for Agent Harness",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "desktop": "electron .",
    "desktop:dist": "node scripts/require-signing.mjs && electron-builder --config electron-builder.yml",
    "desktop:dist:unsigned": "electron-builder --config electron-builder.yml",
    "mobile:sync": "npm run build && cap sync"
  },
  "dependencies": {},
  "devDependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/cli": "8.4.2",
    "@capacitor/core": "8.4.2",
    "@capacitor/ios": "8.4.2",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
