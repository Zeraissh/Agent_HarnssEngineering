# Copy to a secret-managed deployment environment. Never commit populated values.
# Digest-pinned image from the GitHub Release notes. Rollback = previous release's digest.
AGENT_IMAGE=ghcr.io/zeraissh/agent-harness@sha256:REPLACE_FROM_RELEASE_NOTES
AGENT_UI_PORT=4173
AGENT_UI_ACCESS_TOKEN=
AGENT_UI_ALLOWED_ORIGINS=https://agent.example.com
AGENT_UI_BEHIND_TLS_PROXY=1
AGENT_UI_ENABLE_BASH=0
AGENT_UI_MAX_ACTIVE_RUNS=4
AGENT_UI_MAX_STORED_RUNS=100
AGENT_UI_MUTATIONS_PER_MINUTE=120
AGENT_TOTAL_MAX_TURNS=120
# Per-run execution-lineage budget. Verifier/planner each get an equal separate budget
# per verification round, so a verified run's nominal total can exceed 3x this value
# (and grows with subtask count x rounds under plan mode).
AGENT_TOTAL_TOKEN_BUDGET=500000
# Host-level daily cap (non-cache-read tokens, same unit as the burn-rate alert),
# metered per model call. New admissions (runs, follow-ups, archive continuations,
# plan approvals) are refused once exceeded; running tasks are never interrupted.
# 0 = closed for today.
AGENT_UI_DAILY_TOKEN_BUDGET=5000000
# Refuse a new run whose workdir is already used by a running run (default: warn only).
AGENT_UI_EXCLUSIVE_WORKDIR=1
AGENT_MODEL=claude-opus-4-8
AGENT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AGENT_WORKSPACE=
