# Copy to a secret-managed deployment environment. Never commit populated values.
# Digest-pinned image from the GitHub Release notes. Rollback = previous release's digest.
AGENT_IMAGE=ghcr.io/zeraissh/agent-harness@sha256:REPLACE_FROM_RELEASE_NOTES
AGENT_UI_PORT=4173
AGENT_UI_ACCESS_TOKEN=
AGENT_UI_ALLOWED_ORIGINS=https://agent.example.com
AGENT_UI_BEHIND_TLS_PROXY=1
AGENT_UI_ENABLE_BASH=0
# 远程 bash 若另行开启，launcher 强制要求 required；后端不可用时 /ready 与新 run 为 503。
# 当前 Compose 不提供 runtime socket，切勿为省事把 Docker socket 挂进 worker。
AGENT_EXECUTION_ISOLATION=required
AGENT_EXECUTION_BACKEND=oci
# Digest/image-ID pinned execution image; required bash cannot use a mutable tag.
AGENT_EXECUTION_OCI_IMAGE=
# Embedded required execution is Linux-direct-host only. The supplied Compose intentionally has
# no Docker CLI/socket and keeps bash disabled. A separately reviewed direct-host deployment must
# pin all three values below; never use a PATH name such as "docker" or a remote daemon endpoint.
# AGENT_EXECUTION_OCI_RUNTIME=/usr/bin/docker
# AGENT_EXECUTION_OCI_RUNTIME_SHA256=REPLACE_WITH_64_HEX
# AGENT_EXECUTION_OCI_HOST=unix:///var/run/docker.sock
# Stable, deployment-unique ownership partition for durable worker tombstones/reaping.
AGENT_EXECUTION_OCI_NAMESPACE=
# AGENT_EXECUTION_OCI_LEASE_GRACE_MS=15000
# AGENT_EXECUTION_OCI_REAPER_TIMEOUT_MS=30000
AGENT_UI_MAX_ACTIVE_RUNS=4
AGENT_UI_MAX_STORED_RUNS=100
# Same-run exact-input grant caps. Tool-specific limits may only make these stricter;
# checkpoint copies are audit-only and never authorize a restarted/forked run.
AGENT_APPROVAL_GRANT_TTL_MS=900000
AGENT_APPROVAL_GRANT_MAX_USES=5
AGENT_UI_MUTATIONS_PER_MINUTE=120
AGENT_UI_SSE_HEARTBEAT_MS=15000
AGENT_UI_SHUTDOWN_TIMEOUT_MS=15000
AGENT_TOTAL_MAX_TURNS=120
# Per-run execution-lineage budget. Verifier/planner each get an equal separate budget
# per verification round, so a verified run's nominal total can exceed 3x this value
# (and grows with subtask count x rounds under plan mode).
AGENT_TOTAL_TOKEN_BUDGET=500000
# Host-level daily cap (non-cache-read tokens, same unit as the burn-rate alert),
# metered per model call. New admissions (runs, follow-ups, archive continuations,
# plan approvals) are refused once exceeded; running tasks are never interrupted.
# 0 = closed for today.
AGENT_UI_DAILY_TOKEN_BUDGET=5000000
# Refuse a new run whose workdir is already used by a running run (default: warn only).
AGENT_UI_EXCLUSIVE_WORKDIR=1
AGENT_MODEL=claude-opus-4-8
AGENT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AGENT_WORKSPACE=
# Separate host path; completed run archives are copied here with SHA-256 manifests.
AGENT_HISTORY_BACKUP_PATH=
AGENT_RUN_HISTORY_BACKUP_INTERVAL_MS=3600000
