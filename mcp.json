{
  "servers": {
    "stm32": {
      "command": "D:/Work/MCP_Servers/stm32-gdb-mcp/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "mcp_server.server"
      ],
      "cwd": "D:/Work/MCP_Servers/stm32-gdb-mcp",
      "env": {
        "PYTHONPATH": "D:/Work/MCP_Servers/stm32-gdb-mcp/src",
        "STM32_GDB_MCP_COMPACT": "1"
      },
      "permission": "auto",
      "parallelSafe": false,
      "includeTools": [
        "suggest_server_args",
        "start_debug_session",
        "self_check",
        "halt_execution",
        "load_symbols",
        "capture_state",
        "reconstruct_fault_context",
        "read_call_stack",
        "read_variable",
        "read_memory",
        "read_peripheral_register",
        "reset_target",
        "stop_debug_session",
        "flash_firmware",
        "flash_and_run",
        "run_and_wait",
        "run_for_duration",
        "breakpoint",
        "debug_until",
        "write_memory"
      ]
    }
  }
}
