{
  "name": "agent-harness",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Harness engineering agent framework — hand-written agent loop on the Anthropic Messages API",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "agent": "tsx --env-file-if-exists=.env src/cli.ts",
    "cli": "tsx --env-file-if-exists=.env src/cli.ts",
    "doctor": "tsx --env-file-if-exists=.env src/cli.ts --doctor",
    "ui": "tsx --env-file-if-exists=.env ui/serve.ts",
    "eval": "tsx --env-file-if-exists=.env eval/run.ts",
    "ab": "tsx --env-file-if-exists=.env eval/ab.ts",
    "lab": "tsx --env-file-if-exists=.env eval/lab.ts",
    "smoke:local": "tsx --env-file-if-exists=.env eval/smoke-local.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation-smoke": "node scripts/mutation-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "ledger": "tsx --env-file-if-exists=.env eval/ledger-report.ts",
    "ledger:samples": "tsx --env-file-if-exists=.env eval/ledger-samples.ts",
    "eval:stats": "tsx --env-file-if-exists=.env eval/stats.ts",
    "eval:deterministic": "tsx eval/deterministic.ts",
    "e2e:web": "tsx eval/e2e-web.ts",
    "e2e:container": "node scripts/container-health-smoke.mjs",
    "eval:compare-baseline": "tsx eval/compare-baseline-cli.ts",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node scripts/copy-ui-assets.mjs",
    "start": "node --env-file-if-exists=.env dist/ui/serve.js",
    "pack:check": "npm run build && node scripts/check-pack.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@phosphor-icons/web": "^2.1.2",
    "openai": "^6.42.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.7",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.55.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "nanoid": "^3.3.18"
  }
}
