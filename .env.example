# 凭据与端点配置。
#
# 用法：复制成 `.env`（已在 .gitignore 里，不会进仓库），填上自己的值。
# `npm run cli` / `ui` / `eval` / `ab` / `lab` / `smoke:local` 会自动读取它
# （靠 Node 的 `--env-file-if-exists`，不存在就照旧走进程环境变量，零依赖）。
#
# 为什么要有这份文件：此前 key 只活在"启动那个服务的那个终端"里。
# 终端一关就找不回来了，而运行中的服务还在用它——于是"更新到新版"变成了
# "先丢掉凭据再丢掉历史"。凭据的存放位置本身就该是可复现的。

# ---- 执行模型（二选一或都填）----
# Anthropic 官方，或任意 Anthropic 兼容端点（compat 路径）
ANTHROPIC_API_KEY=
# 缺省会复用 ANTHROPIC_API_KEY——同一家的 key 两种协议通用
# OPENAI_API_KEY=

# ---- 端点（用官方就留空）----
# 例：https://api.deepseek.com/anthropic
# ANTHROPIC_BASE_URL=
# OPENAI_BASE_URL=

# ---- 可选：模型与档位 ----
# AGENT_MODEL=claude-opus-4-8
# AGENT_EFFORT=high

# ---- 可选：角色模型（核查者 / planner 各自可用独立端点）----
# AGENT_VERIFIER_MODEL=
# AGENT_VERIFIER_BASE_URL=
# AGENT_VERIFIER_API_KEY=
# AGENT_PLANNER_MODEL=
# AGENT_PLANNER_BASE_URL=
# AGENT_PLANNER_API_KEY=

# ---- Web 宿主 ----
# AGENT_UI_PORT=4173
# AGENT_UI_WORKDIR=
# 多工作目录用分隔符隔开（Windows 用 ;，POSIX 用 :）
# AGENT_UI_WORKDIRS=
# AGENT_UI_MCP=1
