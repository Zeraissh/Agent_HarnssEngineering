# 凭据与端点配置。
#
# 用法：复制成 `.env`（已在 .gitignore 里，不会进仓库），填上自己的值。
# `npm run cli` / `ui` / `eval` / `ab` / `lab` / `smoke:local` 会自动读取它
# （靠 Node 的 `--env-file-if-exists`，不存在就照旧走进程环境变量，零依赖）。
#
# 为什么要有这份文件：此前 key 只活在"启动那个服务的那个终端"里。
# 终端一关就找不回来了，而运行中的服务还在用它——于是"更新到新版"变成了
# "先丢掉凭据再丢掉历史"。凭据的存放位置本身就该是可复现的。

# ---- 执行模型（二选一或都填）----
# Anthropic 官方，或任意 Anthropic 兼容端点（compat 路径）
ANTHROPIC_API_KEY=
# 不跨 provider 隐式复用密钥；选择 openai 时必须显式填写
OPENAI_API_KEY=

# ---- 端点（用官方就留空）----
# 例：https://api.deepseek.com/anthropic
# ANTHROPIC_BASE_URL=
# OPENAI_BASE_URL=

# ---- 可选：模型与档位 ----
# 显式写出，避免台账 model 字段空白导致跨 run 对照缺变量（EVAL-03b）
AGENT_MODEL=deepseek-v4-flash
# AGENT_EFFORT=high

# ---- 可选：视觉模型（describe_image 工具）----
# 配了才会把 describe_image 摆上 CLI/Web 宿主的工具面；没配即干净缺席。
# 端点/协议/key 缺省沿用执行模型的配置（AGENT_VISION_PROVIDER / _BASE_URL / _API_KEY 可覆盖）。
# 接入前先跑探针确认端点真的认图（有的端点 200 但把图静默替换成占位文本）：
#   node --env-file=.env eval/probe-vision.mjs <baseURL> <model>
# 2026-08-24 实测通过：deepseek-v4-flash-vision-exp（deepseek anthropic 兼容端点，双色对照红/蓝均答对）
# AGENT_VISION_MODEL=deepseek-v4-flash-vision-exp

# ---- 可选：生图模型（第五个角色，走 OpenAI 兼容 Images API，不是 chat）----
# 配了才会把 generate_image 摆上工具面；没配即干净缺席。
# AGENT_IMAGE_MODEL=dall-e-3
# AGENT_IMAGE_PROVIDER=openai
# AGENT_IMAGE_BASE_URL=https://api.openai.com/v1
# AGENT_IMAGE_API_KEY=

# ---- 可选：公网检索（web_search / consult 包）----
# 未配则工具不进面（同 describe_image），不摆一调用就报错的空壳。
# AGENT_TAVILY_API_KEY=
# TAVILY_API_KEY=

# ---- 可选：GitHub MCP（mcp.json 的 github server；官方镜像 + PAT）----
# 未配则跳过连接，不拉 docker。Web 宿主还要 AGENT_UI_MCP=1 才会连。
# 别名：AGENT_GITHUB_TOKEN / GITHUB_TOKEN。不要把 PAT 写进 mcp.json。
# 需要本机 Docker；也可用设置页把 command 改成本地 github-mcp-server 二进制。
# GITHUB_PERSONAL_ACCESS_TOKEN=

# ---- 可选：角色模型（核查者 / planner 各自可用独立端点）----
# AGENT_VERIFIER_MODEL=
# AGENT_VERIFIER_BASE_URL=
# AGENT_VERIFIER_API_KEY=
# AGENT_PLANNER_MODEL=
# AGENT_PLANNER_BASE_URL=
# AGENT_PLANNER_API_KEY=

# ---- 可选：端点降级 / 熔断 / 探针（MODEL-01）----
# AGENT_FALLBACK_MODEL=
# AGENT_FALLBACK_PROVIDER=
# AGENT_FALLBACK_BASE_URL=
# AGENT_FALLBACK_API_KEY=
# AGENT_FALLBACK_ROUTING=sequential
# sequential（缺省）= 配置链原序逐个试
# prefer_healthy = 粘性探针标过 unhealthy 的排后/可跳过（有健康候选时）；不是成本路由
# prefer_cheap = 主端点居首，备用按 src/pricing.ts 单价（input+output/1M）升序；
#   未登记单价的备用排最后。这是薄片，不是延迟+成本多目标路由（没有 p50、没有加权打分）
# AGENT_FALLBACK_ROUTING=prefer_cheap
# AGENT_CIRCUIT_FAILURE_THRESHOLD=3
# AGENT_CIRCUIT_COOLDOWN_MS=30000
# 角色链：自有 MODEL，或 FALLBACK=inherit 吃执行者备用端点
# AGENT_VERIFIER_FALLBACK_MODEL=
# AGENT_VERIFIER_FALLBACK=inherit
# AGENT_PLANNER_FALLBACK=
# AGENT_VISION_FALLBACK=
# 能力探针：显式 AGENT_MODEL_PROBE=1 才打；loopback 也不自动开（会吃 mock 脚本）
# 开了之后：compat 以探针为准（Web 异步回写重装执行者）；vision 端点会再探一张最小图，
# 明确拒图则不注册 describe_image
# AGENT_MODEL_PROBE=1
# AGENT_MODEL_PROBE_TTL_MS=300000

# ---- 可选：上下文压缩摘要（MEM-01 Phase B）----
# 默认关。开启后压缩时用执行模型做一次有界摘要，**合并**进 [compact_ledger]，
# 失败则退回 Phase A 启发式。CI/确定性 eval 请保持关闭。
# AGENT_COMPACT_SUMMARY=1
# AGENT_COMPACT_SUMMARY_MAX_TOKENS=512
# 单个 tool_result 进正史前的字符上限（MEM-01 Phase C 入口截断；MCP 返回无上限的兜底）。默认 40000，≥1000
# AGENT_TOOL_RESULT_MAX_CHARS=40000
# 上下文**预算**（策略）：按上一轮实际输入衡量，超过其 80% 触发常规压缩。默认 150000。
# 这是"我们在多少处压"，不是"模型能装多少"——后者是窗口（见下一条），两者曾是同一个数。
# 默认**不**随窗口自动抬高：每轮成本与时延随上下文线性增长，而压缩的质量损失有账本 + 首行摘录
# 兜着，抬预算是按任务权衡的决定。调大 = 更少压缩、更贵的每轮；调小 = 更早压缩、被置换的原文
# 只剩首行摘录。窗口已知时会被夹进 窗口 − maxTokens − 边际（边际 = max(4k, 2%)），夹紧带告警。
# 优先级：Web 逐 run（提交表单的"上下文预算"，区间 [32k, 上限]，越界 400 报区间）> 本条 env > 领域包 > 默认。
# AGENT_CONTEXT_LIMIT=150000
# 上下文**窗口**（事实）：端点在多大处拒收。只在自动解析不对时才需要手填——
# 优先级 本条 env > learned（撞过一次 context-too-long 400 后从报文里学到，按 provider|model|origin
# 记进 <cwd>/.agent-capabilities.json，TTL 30 天）> registry（src/model-windows.ts 的有出处登记表）> 未知。
# 不认识的模型一律"未知"而不猜数：猜大了预算上限虚高照样 400，猜小了白白压缩；界面明说"窗口未知"。
# 2026-09-03 真机实测 deepseek-v4-flash（api.deepseek.com/anthropic）窗口 1,048,576 tokens，
# 且端点按 messages + max_tokens 之和计超长（987k 正文 + 64k completion 就撞 400）——所以上限要减 maxTokens。
# 撞 400 也不是终局：loop 先学窗口、再做一次反应式硬压缩重发同一轮（事件 compaction{reactive}）；
# 兼容路由回的 400 是 OpenAI 信封 + 笼统的 code=invalid_request_error，靠 message 里
# "maximum context length" 识别（真实报文锁在 test/compact-tier2.test.ts）。
# AGENT_CONTEXT_WINDOW=1048576
# 学到的窗口落点（只存身份键与数字，永不存 key；文件坏了当空表）。缺省 <cwd>/.agent-capabilities.json
# AGENT_CAPABILITY_CACHE=.agent-capabilities.json
# 无领域包运行的核查者只读命令白名单（逗号分隔，前缀匹配），替换通用缺省 ls/cat/head/tail/wc/grep/stat/od/diff/git 只读四件。
# 有包时不生效——白名单由包声明，包没声明也不补
# AGENT_VERIFY_READONLY_COMMANDS=ls,cat,head,tail,wc,grep,stat,od,diff,git status,git diff,git log,git show

# ---- Web 宿主 ----
# AGENT_UI_PORT=4173
# 非 loopback 监听必须配置至少 32 字符令牌，并放在 TLS 反向代理之后
# AGENT_UI_ACCESS_TOKEN=
# AGENT_UI_BEHIND_TLS_PROXY=1
# AGENT_UI_ALLOWED_ORIGINS=https://agent.example.com
# 远程宿主默认移除 bash；只有完成隔离审查后才显式开启
# AGENT_UI_ENABLE_BASH=0
# AGENT_UI_ALLOW_REMOTE_EXECUTION=0
# ---- 任意命令执行边界（SAFE-05）----
# 缺省 report：会探测候选能力，但仍以宿主身份执行并在 CLI/UI/tool_result 明示未隔离。
# required：只有功能探测通过的 OCI 后端可执行；不可用即拒绝，绝不回退宿主。
# off 只供明确接受本地风险的兼容场景，且不能同时指定 backend/image。
# AGENT_EXECUTION_ISOLATION=report
# AGENT_EXECUTION_BACKEND=auto
# required+OCI 必须是 repo@sha256:<64hex> 或本地 sha256:<64hex>；不会自动 pull。
# AGENT_EXECUTION_OCI_IMAGE=
# 内嵌 required adapter 只支持 Linux 直宿主。runtime 必须是管理员固定的绝对真实路径，
# 且与文件 SHA-256 成对配置；PATH 查找、Docker context、TCP/SSH daemon 都会被拒绝。
# 先对 `readlink -f "$(command -v docker)"` 的结果计算 sha256sum；Docker 升级后需重算。
# AGENT_EXECUTION_OCI_RUNTIME=/usr/bin/docker
# AGENT_EXECUTION_OCI_RUNTIME_SHA256=
# AGENT_EXECUTION_OCI_HOST=unix:///var/run/docker.sock
# required+OCI 还必须指定稳定、部署唯一的 namespace；daemon labels 只保存其摘要，
# 用于跨进程识别 lease。改名之前必须人工清理旧 namespace 的 schema-3 容器；schema-1/2 也只允许人工迁移。
# AGENT_EXECUTION_OCI_NAMESPACE=agent-harness-dev
# AGENT_EXECUTION_OCI_LEASE_GRACE_MS=15000
# AGENT_EXECUTION_OCI_REAPER_TIMEOUT_MS=30000
# runtime socket 只由 broker 控制面持有，绝不能挂进 agent worker。
# AGENT_UI_MAX_ACTIVE_RUNS=4
# AGENT_UI_MAX_STORED_RUNS=100
# 同 run、同工具、同规范化参数的短期审批上限；仅工具显式声明 exact-input 时生效。
# 缺省 15 分钟/5 次自动复用，宿主硬上限 60 分钟/100 次，并与工具上限取更严格值。
# 完整 checkpoint 只保存审计快照；重启或归档派生的新 run 不恢复授权能力。
# AGENT_APPROVAL_GRANT_TTL_MS=900000
# AGENT_APPROVAL_GRANT_MAX_USES=5
# 宿主级日 token 预算（非 cache_read 口径，逐模型调用实时落账）：超限后新任务/
# 追问/归档派生/计划批准拒绝准入，在飞任务不掐；本地日翻页自动恢复。
# 进程态计数，重启当日归零。缺省不启用；0 = 今日封盘（恒拒新准入）。
# 注意：AGENT_TOTAL_TOKEN_BUDGET / AGENT_TOTAL_MAX_TURNS 是逐 run 的执行谱系
# 硬顶（verifier/planner 每轮核查各计一份等额预算，不从中扣）。缺省不武装——
# 未设置则长对话不会再被 120 轮 / 200 万 token 卡住。跨 run 总闸仍是日预算。
# AGENT_UI_DAILY_TOKEN_BUDGET=5000000
# 同 workdir 并发 run：缺省只在运维日志告警；置 1 升为拒绝（workdir 同时是写入
# 圈禁边界，两个并发 run 互踩产物是静默数据损坏）。并发跑不同任务请各配 workdir
# （AGENT_UI_WORKDIRS 声明白名单）。
# AGENT_UI_EXCLUSIVE_WORKDIR=1
# 状态变更（新建/续跑/上传/改配置）每分钟上限。路径探活、人闸答复不计入。
# AGENT_UI_MUTATIONS_PER_MINUTE=120
# AGENT_UI_SSE_HEARTBEAT_MS=15000
# broker 清理包含强制删除+daemon readback；生产不要低于默认 15000ms。
# AGENT_UI_SHUTDOWN_TIMEOUT_MS=15000
# AGENT_UI_WORKDIR=
# 多工作目录用分隔符隔开（Windows 用 ;，POSIX 用 :）
# AGENT_UI_WORKDIRS=
# 设计模式稿目录。不设则用 ~/Fathom。进入设计模式时，若当前目录是本仓库
# （package.json name=agent-harness），会切到这里，避免稿件写进源码树。
# AGENT_DESIGN_DRAFTS_DIR=
# AGENT_UI_MCP=1
# ---- 可选：执行途中 spawn_task（AGENT-02，默认关）----
# 置 1 才把 spawn_task 摆上工具面。子支线扣父谱系预算、深度 1、并发 cap=3。
# verifier/planner 永远没有这把工具。不是 supervisor，也不替代 propose_handoff。
# Windows 进程隔离仍是 report（SAFE-05）——不假装 AGENT-03 完成。
# AGENT_SPAWN_TASK=0
# ---- 可选：外部 command hooks（docs/09 §4.2，默认关）----
# 指向 JSON 配置。不设 = 整个机制不存在（零开销、零事件）。
# 设了但文件缺失 / JSON 非法 = fail-closed（CLI exit 1 / Web 启动抛）。
# 只认 PreToolUse / PostToolUse / Stop 的 command handler。
# 退出码：0 放行、2 阻断、其它（含 1）与超时 = 非阻断错误。
# hook allow 不能推翻 policy deny / 圈禁 / SAFE-01~03。
# AGENT_HOOKS_CONFIG=

# ---- 可选：AGENT.md 加载上限（docs/09 §4.7）----
# 开关是文件本身：~/.agent/AGENT.md、项目 AGENT.md、.agent/rules/*.md
# 都不在 = 机制不存在。这是指导不是执行，不能授予或撤销权限。
# AGENT_MD_MAX_CHARS=16000

# 文件领域包根目录（drafts/ 待审，installed/ 签字后可选用）。缺省 <cwd>/.agent-packs
# AGENT_PACKS_DIR=
# 自动备份只处理已完成档案，并逐文件 SHA-256 复验。备份目录必须与历史根分离。
# AGENT_RUN_HISTORY_BACKUP_DIR=
# AGENT_RUN_HISTORY_BACKUP_INTERVAL_MS=3600000
