# 凭据与端点配置。
#
# 用法：复制成 `.env`（已在 .gitignore 里，不会进仓库），填上自己的值。
# `npm run cli` / `ui` / `eval` / `ab` / `lab` / `smoke:local` 会自动读取它
# （靠 Node 的 `--env-file-if-exists`，不存在就照旧走进程环境变量，零依赖）。
#
# 为什么要有这份文件：此前 key 只活在"启动那个服务的那个终端"里。
# 终端一关就找不回来了，而运行中的服务还在用它——于是"更新到新版"变成了
# "先丢掉凭据再丢掉历史"。凭据的存放位置本身就该是可复现的。

# ---- 执行模型（二选一或都填）----
# Anthropic 官方，或任意 Anthropic 兼容端点（compat 路径）
ANTHROPIC_API_KEY=
# 不跨 provider 隐式复用密钥；选择 openai 时必须显式填写
OPENAI_API_KEY=

# ---- 端点（用官方就留空）----
# 例：https://api.deepseek.com/anthropic
# ANTHROPIC_BASE_URL=
# OPENAI_BASE_URL=

# ---- 可选：模型与档位 ----
# AGENT_MODEL=claude-opus-4-8
# AGENT_EFFORT=high

# ---- 可选：视觉模型（describe_image 工具）----
# 配了才会把 describe_image 摆上 CLI/Web 宿主的工具面；没配即干净缺席。
# 端点/协议/key 缺省沿用执行模型的配置（AGENT_VISION_PROVIDER / _BASE_URL / _API_KEY 可覆盖）。
# 接入前先跑探针确认端点真的认图（有的端点 200 但把图静默替换成占位文本）：
#   node --env-file=.env eval/probe-vision.mjs <baseURL> <model>
# 2026-08-24 实测通过：deepseek-v4-flash-vision-exp（deepseek anthropic 兼容端点，双色对照红/蓝均答对）
# AGENT_VISION_MODEL=deepseek-v4-flash-vision-exp

# ---- 可选：角色模型（核查者 / planner 各自可用独立端点）----
# AGENT_VERIFIER_MODEL=
# AGENT_VERIFIER_BASE_URL=
# AGENT_VERIFIER_API_KEY=
# AGENT_PLANNER_MODEL=
# AGENT_PLANNER_BASE_URL=
# AGENT_PLANNER_API_KEY=

# ---- Web 宿主 ----
# AGENT_UI_PORT=4173
# 非 loopback 监听必须配置至少 32 字符令牌，并放在 TLS 反向代理之后
# AGENT_UI_ACCESS_TOKEN=
# AGENT_UI_BEHIND_TLS_PROXY=1
# AGENT_UI_ALLOWED_ORIGINS=https://agent.example.com
# 远程宿主默认移除 bash；只有完成隔离审查后才显式开启
# AGENT_UI_ENABLE_BASH=0
# AGENT_UI_ALLOW_REMOTE_EXECUTION=0
# ---- 任意命令执行边界（SAFE-05）----
# 缺省 report：会探测候选能力，但仍以宿主身份执行并在 CLI/UI/tool_result 明示未隔离。
# required：只有功能探测通过的 OCI 后端可执行；不可用即拒绝，绝不回退宿主。
# off 只供明确接受本地风险的兼容场景，且不能同时指定 backend/image。
# AGENT_EXECUTION_ISOLATION=report
# AGENT_EXECUTION_BACKEND=auto
# required+OCI 必须是 repo@sha256:<64hex> 或本地 sha256:<64hex>；不会自动 pull。
# AGENT_EXECUTION_OCI_IMAGE=
# 内嵌 required adapter 只支持 Linux 直宿主。runtime 必须是管理员固定的绝对真实路径，
# 且与文件 SHA-256 成对配置；PATH 查找、Docker context、TCP/SSH daemon 都会被拒绝。
# 先对 `readlink -f "$(command -v docker)"` 的结果计算 sha256sum；Docker 升级后需重算。
# AGENT_EXECUTION_OCI_RUNTIME=/usr/bin/docker
# AGENT_EXECUTION_OCI_RUNTIME_SHA256=
# AGENT_EXECUTION_OCI_HOST=unix:///var/run/docker.sock
# required+OCI 还必须指定稳定、部署唯一的 namespace；daemon labels 只保存其摘要，
# 用于跨进程识别 lease。改名之前必须人工清理旧 namespace 的 schema-3 容器；schema-1/2 也只允许人工迁移。
# AGENT_EXECUTION_OCI_NAMESPACE=agent-harness-dev
# AGENT_EXECUTION_OCI_LEASE_GRACE_MS=15000
# AGENT_EXECUTION_OCI_REAPER_TIMEOUT_MS=30000
# runtime socket 只由 broker 控制面持有，绝不能挂进 agent worker。
# AGENT_UI_MAX_ACTIVE_RUNS=4
# AGENT_UI_MAX_STORED_RUNS=100
# 同 run、同工具、同规范化参数的短期审批上限；仅工具显式声明 exact-input 时生效。
# 缺省 15 分钟/5 次自动复用，宿主硬上限 60 分钟/100 次，并与工具上限取更严格值。
# 完整 checkpoint 只保存审计快照；重启或归档派生的新 run 不恢复授权能力。
# AGENT_APPROVAL_GRANT_TTL_MS=900000
# AGENT_APPROVAL_GRANT_MAX_USES=5
# 宿主级日 token 预算（非 cache_read 口径，逐模型调用实时落账）：超限后新任务/
# 追问/归档派生/计划批准拒绝准入，在飞任务不掐；本地日翻页自动恢复。
# 进程态计数，重启当日归零。缺省不启用；0 = 今日封盘（恒拒新准入）。
# 注意：AGENT_TOTAL_TOKEN_BUDGET 是逐 run 的执行谱系预算（verifier/planner 每轮
# 核查各计一份等额预算，不从中扣），这一条才是跨 run 的总闸。
# AGENT_UI_DAILY_TOKEN_BUDGET=5000000
# 同 workdir 并发 run：缺省只在运维日志告警；置 1 升为拒绝（workdir 同时是写入
# 圈禁边界，两个并发 run 互踩产物是静默数据损坏）。并发跑不同任务请各配 workdir
# （AGENT_UI_WORKDIRS 声明白名单）。
# AGENT_UI_EXCLUSIVE_WORKDIR=1
# AGENT_UI_MUTATIONS_PER_MINUTE=120
# AGENT_UI_SSE_HEARTBEAT_MS=15000
# broker 清理包含强制删除+daemon readback；生产不要低于默认 15000ms。
# AGENT_UI_SHUTDOWN_TIMEOUT_MS=15000
# AGENT_UI_WORKDIR=
# 多工作目录用分隔符隔开（Windows 用 ;，POSIX 用 :）
# AGENT_UI_WORKDIRS=
# AGENT_UI_MCP=1
# 自动备份只处理已完成档案，并逐文件 SHA-256 复验。备份目录必须与历史根分离。
# AGENT_RUN_HISTORY_BACKUP_DIR=
# AGENT_RUN_HISTORY_BACKUP_INTERVAL_MS=3600000
