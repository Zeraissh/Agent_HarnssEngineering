# 凭据与端点配置。
#
# 用法：复制成 `.env`（已在 .gitignore 里，不会进仓库），填上自己的值。
# `npm run cli` / `ui` / `eval` / `ab` / `lab` / `smoke:local` 会自动读取它
# （靠 Node 的 `--env-file-if-exists`，不存在就照旧走进程环境变量，零依赖）。
#
# 为什么要有这份文件：此前 key 只活在"启动那个服务的那个终端"里。
# 终端一关就找不回来了，而运行中的服务还在用它——于是"更新到新版"变成了
# "先丢掉凭据再丢掉历史"。凭据的存放位置本身就该是可复现的。

# ---- 执行模型（二选一或都填）----
# Anthropic 官方，或任意 Anthropic 兼容端点（compat 路径）
ANTHROPIC_API_KEY=
# 缺省会复用 ANTHROPIC_API_KEY——同一家的 key 两种协议通用
# OPENAI_API_KEY=

# ---- 端点（用官方就留空）----
# 例：https://api.deepseek.com/anthropic
# ANTHROPIC_BASE_URL=
# OPENAI_BASE_URL=

# ---- 可选：模型与档位 ----
# AGENT_MODEL=claude-opus-4-8
# AGENT_EFFORT=high

# ---- 可选：视觉模型（describe_image 工具）----
# 配了才会把 describe_image 摆上 CLI/Web 宿主的工具面；没配即干净缺席。
# 端点/协议/key 缺省沿用执行模型的配置（AGENT_VISION_PROVIDER / _BASE_URL / _API_KEY 可覆盖）。
# 接入前先跑探针确认端点真的认图（有的端点 200 但把图静默替换成占位文本）：
#   node --env-file=.env eval/probe-vision.mjs <baseURL> <model>
# 2026-08-24 实测通过：deepseek-v4-flash-vision-exp（deepseek anthropic 兼容端点，双色对照红/蓝均答对）
# AGENT_VISION_MODEL=deepseek-v4-flash-vision-exp

# ---- 可选：角色模型（核查者 / planner 各自可用独立端点）----
# AGENT_VERIFIER_MODEL=
# AGENT_VERIFIER_BASE_URL=
# AGENT_VERIFIER_API_KEY=
# AGENT_PLANNER_MODEL=
# AGENT_PLANNER_BASE_URL=
# AGENT_PLANNER_API_KEY=

# ---- Web 宿主 ----
# AGENT_UI_PORT=4173
# 非 loopback 监听必须配置至少 32 字符令牌，并放在 TLS 反向代理之后
# AGENT_UI_ACCESS_TOKEN=
# AGENT_UI_BEHIND_TLS_PROXY=1
# AGENT_UI_ALLOWED_ORIGINS=https://agent.example.com
# 远程宿主默认移除 bash；只有完成隔离审查后才显式开启
# AGENT_UI_ENABLE_BASH=0
# AGENT_UI_ALLOW_REMOTE_EXECUTION=0
# AGENT_UI_MAX_ACTIVE_RUNS=4
# AGENT_UI_MAX_STORED_RUNS=100
# 宿主级日 token 预算（非 cache_read 口径）：超限后新任务/追问/归档派生拒绝准入，
# 在飞任务不掐；本地日翻页自动恢复。进程态计数，重启当日归零。缺省不启用。
# 注意：AGENT_TOTAL_TOKEN_BUDGET 是逐 run 的执行谱系预算（verifier/planner 各有
# 独立等额预算，不从中扣），这一条才是跨 run 的总闸。
# AGENT_UI_DAILY_TOKEN_BUDGET=5000000
# AGENT_UI_MUTATIONS_PER_MINUTE=120
# AGENT_UI_WORKDIR=
# 多工作目录用分隔符隔开（Windows 用 ;，POSIX 用 :）
# AGENT_UI_WORKDIRS=
# AGENT_UI_MCP=1
